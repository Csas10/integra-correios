{
  "name": "integra-correios",
  "version": "2.0.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Fundação auditável do cockpit operacional PF/PJ para pré-postagem nos Correios",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/worker",
    "packages/*"
  ],
  "scripts": {
    "policy:repo": "node scripts/verify-repository.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit --pretty false",
    "test": "vitest run",
    "security:secrets": "node scripts/security-scan.mjs secrets",
    "security:pii": "node scripts/security-scan.mjs pii",
    "build": "tsc -b --force --pretty false",
    "build:web": "npm run build --workspace=@integra-correios/web",
    "mail:homologation": "npm run build && node apps/worker/dist/mail-homologation.js",
    "build:vercel": "npm run build && npm run build:web",
    "verify:vercel-runtime": "node scripts/verify-vercel-runtime.mjs",
    "operator:credential": "node scripts/operator-credential.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@integra-correios/api": "*",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  }
}
